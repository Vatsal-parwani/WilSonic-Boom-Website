---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Close from '../../components/Close.astro';
import { posts, longDate } from '../../lib/updates';
import { url, href } from '../../components/url';
---
<Base title="Updates" current="updates" description="Updates from Wilsonic Boom, FTC team 33001: the robot, the season and the team.">

  <PageHead lines={['Updates.']} />

  <section class="band band--tight" id="articles">
    <div class="wrap">
      {posts.length > 0 ? (
        <ol class="posts">
          {posts.map((p) => (
            <li>
              <a class:list={['post', { 'post--cover': p.cover }]} href={url(`/updates/${p.slug}/`)}>
                {p.cover && <span class="post__cover"><img src={href(p.cover)} alt="" loading="lazy" decoding="async" /></span>}
                <span class="post__date num">{longDate(p.date)}{p.draft && ' · draft'}</span>
                <span class="post__main">
                  <span class="post__title">{p.title}</span>
                  {p.summary && <span class="post__sum">{p.summary}</span>}
                </span>
                {p.author && <span class="post__by">{p.author}</span>}
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <p class="log__none">No updates yet.</p>
      )}
    </div>
  </section>

  <Close />
</Base>
