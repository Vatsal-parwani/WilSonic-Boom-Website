---
// HOME — the whole pitch on its own. A sponsor who reads only this page
// should still know what the team is, why it is credible, and how to act.
import Base from '../layouts/Base.astro';
import Slot from '../components/Slot.astro';
import Specs from '../components/Specs.astro';
import DataPlate from '../components/DataPlate.astro';
import MoreLink from '../components/MoreLink.astro';
import Close from '../components/Close.astro';
import { url, href } from '../components/url';
import site from '../data/site.json';
import SponsorStrip from '../components/SponsorStrip.astro';
import { headcount } from '../lib/team';
import { lastCompleted as season, latestVersion } from '../lib/seasons';
import sponsors from '../data/sponsors.json';
import outreach from '../data/outreach.json';

const latest = latestVersion(season);
const mail = `mailto:${site.email}?subject=Sponsorship%20enquiry%20%E2%80%94%20FTC%2033001`;
---
<Base current="home" description="Wilsonic Boom, FIRST Tech Challenge team 33001 at Wilson's School, Wallington. The team, its robot, its record, and how to sponsor it.">

  <!-- ═══ OPENING ═══ -->
  <section class="hero" id="top">
    <div class="hero__grid">
      <div class="plate plate--title" data-cut>
        <p class="serial">
          <span class="serial__k">TEAM</span><span class="serial__v">{site.teamNumber}</span>
          <span class="serial__k">SCHOOL</span><span class="serial__v">{site.school.replace(' School', '')}, {site.town}</span>
          <img class="serial__badge" src={url('/brand/badge-256.webp')} alt="The Wilsonic Boom badge" width="88" height="88" decoding="async" />
        </p>
        <h1 class="etch" data-etch>Wilsonic<br>Boom.</h1>
        <p class="lede">
          The junior FIRST Tech Challenge team at Wilson&rsquo;s School in
          Wallington{headcount && <>: {headcount}</>}. Our first season brought three awards:
          Finalist Alliance and the Reach Award at Regionals, and the Sustain Award at
          Nationals.
        </p>
        <div class="actions">
          <a class="btn btn--gold" href={mail}>Sponsor the team</a>
          <a class="btn btn--ghost" href={href(site.sponsorshipPack)} download>
            <svg class="ico" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 2 L8 11" /><path d="M4.5 7.5 L8 11 L11.5 7.5" /><path d="M3 13.5 L13 13.5" /></svg>
            Sponsorship pack
          </a>
        </div>
      </div>
      <!-- The robot on a layered stage: a machined back plate with a grid and
           the team number, a turntable, then the cut-out robot standing on it.
           Still by design; the two hero boxes share one height. -->
      <div class="podium" data-podium>
        <div class="podium__plate" data-cut aria-hidden="true">
          <div class="podium__grid"></div>
          <span class="podium__num">{site.teamNumber}</span>
        </div>
        <!-- The turntable is drawn in the photo's own perspective: the camera
             looks down about 18°, so the floor ellipse is ~0.3 as deep as wide.
             The contact shade under the wheels is what makes it stand, not float. -->
        <svg class="podium__table" viewBox="0 0 600 200" aria-hidden="true" focusable="false">
          <defs>
            <radialGradient id="podium-contact" cx="50%" cy="50%" r="50%">
              <stop offset="0" stop-color="#000" stop-opacity=".62" />
              <stop offset=".55" stop-color="#000" stop-opacity=".28" />
              <stop offset="1" stop-color="#000" stop-opacity="0" />
            </radialGradient>
          </defs>
          <ellipse cx="300" cy="100" rx="290" ry="88" class="t-face" />
          <ellipse cx="300" cy="100" rx="290" ry="88" class="t-ring" />
          <ellipse cx="300" cy="100" rx="236" ry="71" class="t-ring t-ring--in" />
          {Array.from({ length: 72 }, (_, i) => {
            const a = (i / 72) * Math.PI * 2;
            const long = i % 6 === 0;
            const r1 = long ? 0.9 : 0.95;
            return <line x1={300 + 290 * Math.cos(a)} y1={100 + 88 * Math.sin(a)} x2={300 + 290 * r1 * Math.cos(a)} y2={100 + 88 * r1 * Math.sin(a)} class:list={['t-tick', { 't-tick--long': long }]} />;
          })}
          <ellipse cx="300" cy="112" rx="215" ry="52" fill="url(#podium-contact)" />
        </svg>
        <figure class="podium__robot">
          {site.homePhoto
            ? <img src={href(site.homePhoto)} alt="The Wilsonic Boom competition robot" decoding="async" fetchpriority="high" />
            : <div class="podium__empty"><p class="slot__name">Robot, cut-out</p><p class="slot__spec">Transparent PNG · three-quarter view · 2400 px wide</p></div>}
        </figure>
        <p class="podium__tag" aria-hidden="true">
          <span>{season.game}</span><span>{season.years}</span>
        </p>
      </div>
    </div>
    <div class="rule rule--scale" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
      <span></span><span></span><span></span><span></span><span></span>
    </div>
    <div class="wrap hero__sponsors">
      <SponsorStrip />
    </div>
  </section>

  <!-- ═══ THE CASE ═══ -->
  <section class="band" id="why">
    <div class="wrap wrap--split">
      <div class="split__l"><h2 class="h2 etch" data-etch>What your money<br>actually does.</h2></div>
      <div class="split__r">
        <p class="body">
          An FTC season runs on parts that wear out and parts that did not exist until we made
          them. Sponsorship is a small line in a marketing budget and a large line in ours: it
          is the difference between rebuilding a subsystem that failed and living with it for
          the rest of the season.
        </p>
        <p class="body">
          In return your name goes on our robot, kit and banners, in front of every team and judge
          we compete against. Sponsorship is shared with our senior team, Wilsobotics, so it
          supports both.
        </p>
        <Specs rows={sponsors.funding.slice(0, 5).map((f) => ({ k: f.item, v: f.cost }))} />
        <MoreLink href="/sponsor-the-team/">Everything it pays for, and the tiers</MoreLink>
      </div>
    </div>
  </section>

  <!-- ═══ RECORD, AT A GLANCE ═══ -->
  <section class="band band--alt" id="record">
    <div class="wrap">
      <h2 class="h2 etch" data-etch>Record</h2>
      <div class="record">
        <DataPlate title="Competition record" serial={site.teamNumber} rows={season.record} foot={['FIRST® Tech Challenge', "Wilson's School · Wallington"]} />
        <div class="record__side">
          <p class="h4 record__lbl">{season.game} · {season.years}</p>
          <p class="body">{season.summary}</p>
          <MoreLink href="/season/">Every event and result</MoreLink>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ THE MACHINE — a teaser; the assembly lives on /robot ═══ -->
  <section class="band" id="machine">
    <div class="wrap">
      <h2 class="h2 etch" data-etch>The machine</h2>
      <div class="teaser">
        <figure class="teaser__stage" data-cut>
          <Slot name="Robot, full assembly" spec="16:10 · 2800 px" ratio="16 / 10" src={latest?.photo ?? null} alt="The competition robot" />
        </figure>
        <div class="teaser__side">
          {latest && <p class="h4 teaser__ver">{/\./.test(latest.id) ? latest.id : `${latest.id}.0`} · {latest.title}</p>}
          <p class="body">
            {latest?.summary ?? `Every version we built for ${season.game}.`}
          </p>
          {(latest?.subsystems ?? []).length > 0 && (
            <ol class="teaser__list">
              {latest!.subsystems.map((s) => (
                <li><span class="key__n num">{s.n}</span><span>{s.name}</span></li>
              ))}
            </ol>
          )}
          <MoreLink href="/robot/">Every version of the robot</MoreLink>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ REACH ═══ -->
  <section class="band band--alt" id="reach">
    <div class="wrap wrap--split">
      <div class="split__l"><h2 class="h2 etch" data-etch>Beyond<br>the robot.</h2></div>
      <div class="split__r">
        <p class="body">
          The team runs clubs across the school every week, from Junior Robotics to the KS4
          Coding Club, and won the Reach Award for it at Regionals.
        </p>
        <Specs rows={outreach.numbers} />
        <MoreLink href="/outreach/">What we do beyond the robot</MoreLink>
      </div>
    </div>
  </section>

  <Close />
</Base>
